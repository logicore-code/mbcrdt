// Module configuration for mbcrdt, a CRDT library for MoonBit.
// Learn more at https://docs.moonbitlang.com/en/latest/toolchain/moon/module.html

name = "logicore-code/mbcrdt"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/logicore-code/mbcrdt"

license = "Apache-2.0"

keywords = [ "crdt", "distributed", "collaboration", "offline-first", "wasm" ]

preferred_target = "wasm"

description = "A pure-MoonBit Conflict-free Replicated Data Type library: state-based and op-based counters, sets, registers, maps and a Replicated Growable Array for collaborative editing. Zero dependencies, runs on wasm/wasm-gc/js/native targets."
